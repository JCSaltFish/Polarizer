/**
 * @file bound.comp
 * @brief Compute shader for calculating the axis-aligned bounding box (AABB) of a scene.
 */

#version 450

layout(local_size_x = 128) in;

/**
 * @brief Uniform buffer containing global information for BVH construction.
 */
layout(binding = 0) uniform BvhGlobal {
    uint nElements; // Total number of elements
} u_bvhGlobal; // BVH global information buffer

/**
 * @brief Struct representing a model instance in the scene.
 */
struct ModelRef {
    uint idxBlasRoot; // Index of the root node of the BLAS tree for this model
    uint padding[3]; // Padding for alignment
    vec4 aabbMin; // Minimum corner of the axis-aligned bounding box (AABB) for the instance
    vec4 aabbMax; // Maximum corner of the axis-aligned bounding box (AABB) for the instance
    mat4 xform; // Transformation matrix for this instance
    mat4 invXform; // Inverse transformation matrix for this instance
};
/**
 * @brief Storage buffer for storing the model instances in the scene.
 */
layout(binding = 1) buffer ModelRefs {
    ModelRef modelRefs[]; // Array of model references
} b_modelRefs; // Model references buffer

/**
 * @brief Struct representing a node in the BVH tree.
 */
struct BvhNode {
    int idxLeft; // Index of the left child node
    int idxRight; // Index of the right child node
    int idxParent; // Index of the parent node
    int idxElement; // Index of the element for leaf nodes

    vec4 aabbMin; // Minimum corner of the axis-aligned bounding box (AABB) for the node
    vec4 aabbMax; // Maximum corner of the axis-aligned bounding box (AABB) for the node
};
/**
 * @brief Storage buffer for storing the BVH nodes of the trees for all models.
 */
layout(binding = 2) readonly buffer BLASs {
    BvhNode nodes[]; // Array of BVH nodes representing the internal structure of the BVH trees
} b_BLASs; // BLAS nodes buffer

/**
 * @brief Storage buffer for storing the global minimum and maximum bounds of the scene.
 */
layout(binding = 3) buffer BoundsUINT {
    uvec4 minBound; // Minimum bound of the AABB (stored as ordered uints)
    uvec4 maxBound; // Maximum bound of the AABB (stored as ordered uints)
} b_boundsUINT; // Bounds buffer

shared vec3 s_minBound[gl_WorkGroupSize.x]; // Shared array for storing local minimum bounds
shared vec3 s_maxBound[gl_WorkGroupSize.x]; // Shared array for storing local maximum bounds

const float INFINITY = 1e20; // Large value representing infinity

/**
 * @brief Converts a float to an ordered uint for atomic operations. This ensures that the ordering
 *        of the floats is preserved when using atomicMin and atomicMax.
 * @param v The float value to convert.
 * @return The ordered uint representation of the float.
 */
uint floatToOrderedUint(float v) {
    uint x = floatBitsToUint(v);
    return (x & 0x80000000u) != 0 ? ~x : x | 0x80000000u;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;

    /* Each thread computes the local AABB for its assigned element */

    vec3 localMin = vec3(INFINITY);
    vec3 localMax = vec3(-INFINITY);
    if (gid < u_bvhGlobal.nElements) {
        ModelRef ref = b_modelRefs.modelRefs[gid];
        BvhNode node = b_BLASs.nodes[ref.idxBlasRoot];

        vec3 bmin = node.aabbMin.xyz;
        vec3 bmax = node.aabbMax.xyz;

        vec3 center = (bmin + bmax) * 0.5;
        vec3 extent = (bmax - bmin) * 0.5;

        vec3 worldCenter = (ref.xform * vec4(center, 1.0)).xyz;

        mat3 m = mat3(ref.xform);
        mat3 absM = mat3(abs(m[0]), abs(m[1]), abs(m[2]));

        vec3 worldExtent = absM * extent;

        localMin = worldCenter - worldExtent;
        localMax = worldCenter + worldExtent;

        b_modelRefs.modelRefs[gid].aabbMin = vec4(localMin, 0.0);
        b_modelRefs.modelRefs[gid].aabbMax = vec4(localMax, 0.0);
    }
    s_minBound[lid] = localMin;
    s_maxBound[lid] = localMax;

    barrier();

    /* Perform a parallel reduction to find the minimum and maximum bounds for the block */
    for (uint stride = gl_WorkGroupSize.x / 2; stride > 0; stride >>= 1) {
        if (lid < stride) {
            s_minBound[lid] = min(s_minBound[lid], s_minBound[lid + stride]);
            s_maxBound[lid] = max(s_maxBound[lid], s_maxBound[lid + stride]);
        }
        barrier();
    }

    /* The first thread in the block updates the global bounds using atomic operations */
    if (lid == 0) {
        vec3 globalMin = s_minBound[0];
        vec3 globalMax = s_maxBound[0];

        atomicMin(b_boundsUINT.minBound.x, floatToOrderedUint(globalMin.x));
        atomicMin(b_boundsUINT.minBound.y, floatToOrderedUint(globalMin.y));
        atomicMin(b_boundsUINT.minBound.z, floatToOrderedUint(globalMin.z));

        atomicMax(b_boundsUINT.maxBound.x, floatToOrderedUint(globalMax.x));
        atomicMax(b_boundsUINT.maxBound.y, floatToOrderedUint(globalMax.y));
        atomicMax(b_boundsUINT.maxBound.z, floatToOrderedUint(globalMax.z));
    }
}
